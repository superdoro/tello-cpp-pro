build/
build-*/
.cache/
compile_commands.json
*.o
*.obj
*.so
*.a
.vscode/
.idea/

# Generated by the pipeline, not source. Maps are large binaries tied to one
# camera calibration and one vocabulary, so they are rebuilt rather than
# shared; scripts/fetch_vocabulary.sh re-extracts the vocabulary from the
# ORB-SLAM3 submodule.
maps/*
!maps/.gitkeep
recordings/
third_party/ORB_SLAM3/Vocabulary/ORBvoc.txt

# Test fixtures: make_synthetic_video regenerates them deterministically from
# its seed, so there is no reason to store 30MB of AVI in the repo.
tests/data/*.avi
tests/data/synthetic_truth.txt
tests/data/synthetic_camera.yaml
config/mission_synthetic.yaml
